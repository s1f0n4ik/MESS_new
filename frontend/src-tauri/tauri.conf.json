{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postcards",
  "version": "2.0.4",
  "identifier": "ru.mess.postcards",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/postcards-backend"],
    "resources": ["pdfs-default/Postcards_2x2_template_14_blocks.pdf"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
