# Copy to nas.env on the NAS. Do not commit the real token.
POSTCARDS_SERVER=https://mess-studio.ru
POSTCARDS_SYNC_TOKEN=replace-with-STUDIO_SYNC_TOKEN
POSTCARDS_INTERVAL=30

# A subfolder inside the host directory already mounted into the yandex.disk
# container as /root/Yandex.Disk. Confirm the exact host path in UGREEN Docker.
NAS_POSTCARDS_PATH=/path/on/nas/yandex.disk-data/Postcards-Studio
